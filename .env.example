# Copy this file to .env and fill in your real key. .env is gitignored —
# never commit a real API key.
#
# Get a key at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Optional — port the Press Box proxy (server/index.mjs) listens on.
# Defaults to 8787 if unset. Only change this if you also update the
# proxy target in vite.config.js.
# PRESS_BOX_PROXY_PORT=8787
